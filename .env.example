# THE LAST CLUE — variables d'environnement
# Copier en .env.local et compléter. Ne jamais committer de vraies clés.

# Clés publiques Supabase (exposées au navigateur, protégées par RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Source des données de jeu : "mock" (prototype local) ou "supabase"
VITE_DATA_SOURCE=mock

# Secrets serveur UNIQUEMENT (Edge Functions / CI) — ne jamais préfixer par VITE_
# SUPABASE_SERVICE_ROLE_KEY=
